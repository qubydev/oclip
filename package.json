{
  "name": "oclip",
  "version": "0.1.0",
  "description": "An open-source desktop video editor",
  "type": "module",
  "main": "desktop/main.cjs",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build": "npx --yes electron-builder@26 --win nsis --x64",
    "preview": "node desktop/preview.mjs",
    "dev": "electron . --oclip-dev"
  },
  "build": {
    "appId": "oclip.editor",
    "productName": "oclip",
    "files": [
      "index.html",
      "src/**/*",
      "desktop/**/*.cjs",
      "assets/**/*"
    ],
    "win": {
      "icon": "assets/oclip.ico",
      "artifactName": "oclip-Setup-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "45.3.2"
  }
}
