{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "rootDir": ".",
    "outDir": ".build",
    "strict": false,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "desktop/**/*.cts",
    "desktop/**/*.mts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.cts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".build"
  ]
}
